# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Optional Sentry server error monitoring. Events omit request/user data and error messages.
SENTRY_DSN=""

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links and payment checkout return URLs.
APP_URL="MY_APP_URL"

# Billing database and Dodo Payments.
# Create the PostgreSQL database in Render and use its connection string.
DATABASE_URL="YOUR_RENDER_POSTGRES_CONNECTION_STRING"
# Set PGSSL=true only when your Render PostgreSQL connection requires TLS.
# Keep certificate validation enabled unless Render support provides a CA-specific reason otherwise.
PGSSL="false"
PGSSL_REJECT_UNAUTHORIZED="true"

# Use test_mode while verifying checkout and webhooks. Switch to live_mode only after testing.
DODO_ENVIRONMENT="test_mode"
DODO_PAYMENTS_API_KEY="YOUR_DODO_API_KEY"
DODO_PAYMENTS_WEBHOOK_KEY="YOUR_DODO_WEBHOOK_SIGNING_SECRET"

# Product IDs from the Dodo dashboard. Prices and entitlements are configured in Dodo:
# Monthly: $10 USD / 10,000 credits per billing cycle
# Yearly: $96 USD / 13,500 credits per annual cycle
# Starter booster: $5 USD / 500 non-expiring credits
# Power User booster: $20 USD / 2,500 non-expiring credits
DODO_PRODUCT_ID_MONTHLY="pdt_0NqjBuuF3ooTMGWPBib7P"
DODO_PRODUCT_ID_YEARLY="pdt_0NqjFbKSPXbU4ad7dpAdP"
DODO_PRODUCT_ID_STARTER="pdt_0NqjHPdLqLmYkQgrBYVPg"
DODO_PRODUCT_ID_POWER="pdt_0NqjI8zzf9JXyJfN0RhK2"

# SMTP settings are required to register users and verify their email before sign-in.
SMTP_HOST="YOUR_SMTP_HOST"
SMTP_PORT="587"
SMTP_USER="YOUR_SMTP_USERNAME"
SMTP_PASSWORD="YOUR_SMTP_PASSWORD"
SMTP_FROM="OmniSci <no-reply@example.com>"
